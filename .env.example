# Production: PostgreSQL connection string (Runpod-approved provider).
# When unset, the app uses an embedded PGlite database at .data/pglite (local dev only).
DATABASE_URL=

# Auth provider: "dev" (local cookie-based identity) or "sso" (requires SSO integration, see docs/deployment-vercel.md)
# dev (local only) | google (recommended for production) | oidc (any OIDC IdP,
# e.g. Okta) | sso (signed-header identity proxy)
AUTH_PROVIDER=dev

# Google/OIDC sign-in (AUTH_PROVIDER=google or oidc).
# Defaults: issuer https://accounts.google.com, allowed domain runpod.io.
# GOOGLE_CLIENT_ID/SECRET come from a Google Workspace OAuth client whose
# authorized redirect URI is <APP_URL>/api/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generic OIDC overrides (take precedence over GOOGLE_*): point these at Okta
# or another IdP without code changes.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAIL_DOMAINS=runpod.io
# 32+ character random secret signing the login session cookie. Required for
# google/oidc. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared HMAC secret used by the approved identity-aware proxy to sign the
# x-runpod-auth-email / timestamp / signature headers. Required for sso.
SSO_HEADER_SECRET=

# Secret used to protect the outbox processing endpoint (cron worker). Required in production.
OUTBOX_PROCESS_TOKEN=

# Vercel injects this bearer secret into configured cron requests.
CRON_SECRET=

# Optional operator token for manually invoking the GTM source reconciliation
# worker. Vercel cron uses CRON_SECRET automatically.
SOURCE_SYNC_TOKEN=

# Notion internal integration token used only by configured GTM source
# connectors. Never store this value in the GTM catalog itself.
NOTION_API_TOKEN=

# Slack app (slash command, modals, shortcuts, CSV bulk upload)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_ALLOWED_ENTERPRISE_IDS=
SLACK_ALLOWED_TEAM_IDS=
# Optional fallback when Slack profile emails cannot be read: {"U123":"person@runpod.io"}
SLACK_USER_EMAIL_MAP_JSON={}
# Canonical deployed URL used in Slack result links
APP_URL=http://localhost:3000

# HubSpot private-app token for campaign sync (optional; sync stays queued without it)
HUBSPOT_ACCESS_TOKEN=

# Comma-separated allowlist of production Chrome extension IDs. Required in
# production before the extension PKCE flow and CORS access are enabled.
EXTENSION_IDS=

# Explicit opt-in for local-development fallbacks that would otherwise fail
# closed (unset EXTENSION_IDS allowlist, unset Slack workspace allowlist).
# Ignored entirely in production builds. Never set this on a shared deployment.
ALLOW_INSECURE_DEV=
